@@ -207,7 +207,10 @@ class OpticalFlowTyped : public OpticalFlowBase {
     E.resize(getNumCams());
     for (size_t i = 0; i < getNumCams(); i++) {
       Eigen::Matrix4d Ed;
-      SE3 T_i_j = calib.T_i_c[0].inverse() * calib.T_i_c[1];
+      // OpenView patch 0001: with a single camera there is no T_i_c[1]; the
+      // essential matrices are only used for stereo matching, so fall back
+      // to identity instead of reading past the calibration vector.
+      SE3 T_i_j = getNumCams() > 1 ? calib.T_i_c[0].inverse() * calib.T_i_c[1] : SE3();
       computeEssential(T_i_j.template cast<double>(), Ed);
       E[i] = Ed.cast<Scalar>();
     }
