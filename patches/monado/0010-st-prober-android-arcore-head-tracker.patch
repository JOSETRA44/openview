From: OpenView contributors
Subject: [PATCH] st/prober: ARCore as the Android head tracker when available

Basalt with one camera diverges when the head turns in place (measured on a
phone: metres of drift after one turn). Where the phone has ARCore, the
factory now asks OpenView's ARCore tracker (tracking/arcore, linked into the
prober by OpenView's CMake when OPENVIEW_HAVE_ARCORE is set) and only falls
back to the SLAM camera tracker when ARCore is not available. ARCore owns the
camera, so the SLAM frameserver is not opened while it runs.
ANDROID_TRACKER=auto|arcore|slam (debug.xrt.ANDROID_TRACKER) chooses.

---
diff --git a/src/xrt/state_trackers/prober/p_tracking.c b/src/xrt/state_trackers/prober/p_tracking.c
index 5f0d5aa..676f8cb 100644
--- a/src/xrt/state_trackers/prober/p_tracking.c
+++ b/src/xrt/state_trackers/prober/p_tracking.c
@@ -46,6 +46,13 @@ DEBUG_GET_ONCE_NUM_OPTION(rs_source_index, "RS_SOURCE_INDEX", -1)
 #include <unistd.h>
 // Off until 6DoF tracks on a device: setprop debug.xrt.ANDROID_SLAM_CAMERA true
 DEBUG_GET_ONCE_BOOL_OPTION(android_slam_camera, "ANDROID_SLAM_CAMERA", true)
+// Which tracker gives the head position: auto (ARCore, else SLAM), arcore or slam.
+// setprop debug.xrt.ANDROID_TRACKER slam
+DEBUG_GET_ONCE_OPTION(android_tracker, "ANDROID_TRACKER", "auto")
+
+#ifdef OPENVIEW_HAVE_ARCORE
+#include "openview/arcore_tracker.h"
+#endif
 
 #ifdef XRT_FEATURE_SLAM
 /*!
@@ -331,6 +338,25 @@ p_factory_ensure_slam_frameserver(struct p_factory *fact)
 	// SLAM tracker with Android camera frameserver
 
 #ifdef XRT_BUILD_DRIVER_ANDROID
+#ifdef OPENVIEW_HAVE_ARCORE
+	// ARCore first where the phone has it: it owns the camera, so the SLAM
+	// frameserver below is not opened when ARCore runs.
+	{
+		const char *choice = debug_get_option_android_tracker();
+		if (strcmp(choice, "slam") != 0) {
+			if (ov_arcore_tracker_create(&fact->xfctx, &fact->xts) == 0) {
+				U_LOG_I("Head tracker: ARCore");
+				return true;
+			}
+			fact->xts = NULL;
+			if (strcmp(choice, "arcore") == 0) {
+				U_LOG_W("Head tracker: ARCore requested but unavailable, orientation only");
+				return false;
+			}
+			U_LOG_I("Head tracker: ARCore unavailable, trying the SLAM tracker");
+		}
+	}
+#endif
 	if (debug_get_bool_option_android_slam_camera()) {
 #ifdef XRT_FEATURE_SLAM
 		// The backend ships inside the runtime APK, so dlopen finds it by
