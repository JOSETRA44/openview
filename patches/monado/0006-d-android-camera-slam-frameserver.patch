+// Copyright 2026, OpenView contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Frameserver that feeds the SLAM tracker from the phone's own
+ *         camera and IMU.
+ *
+ * The desktop SLAM sources (EuRoC player, RealSense) pair a frameserver
+ * with the VIT tracker through the prober's tracking factory. Android has
+ * no video device to enumerate, so this frameserver wraps the NDK camera
+ * and sensor APIs directly: AImageReader delivers YUV_420_888 frames whose
+ * Y plane is the grayscale image the tracker consumes, and a sensor thread
+ * mirrors the one in android_sensors.c, except that samples are pushed to
+ * the SLAM sinks in the IMU's own axes. The axis convention deliberately
+ * matches the sensor-recorder captures that the phone calibration
+ * candidates were fitted against, not the permuted frame the 3DoF fusion
+ * uses for display.
+ *
+ * Camera and sensor timestamps both live on CLOCK_BOOTTIME while Monado
+ * timepoints are CLOCK_MONOTONIC; both streams are converted with the
+ * same resampled-offset helper android_sensors.c uses, so camera and IMU
+ * stay in one domain.
+ *
+ * @ingroup drv_android
+ */
+
+#include "android_camera_fs.h"
+
+#include "xrt/xrt_frame.h"
+#include "xrt/xrt_tracking.h"
+
+#include "math/m_api.h"
+
+#include "os/os_threading.h"
+#include "os/os_time.h"
+
+#include "util/u_frame.h"
+#include "util/u_frameserver.h"
+#include "util/u_logging.h"
+#include "util/u_misc.h"
+
+#include <xrt/xrt_config_android.h>
+
+#include <android/looper.h>
+#include <android/native_window.h>
+#include <android/sensor.h>
+
+#include <camera/NdkCameraCaptureSession.h>
+#include <camera/NdkCameraDevice.h>
+#include <camera/NdkCameraManager.h>
+#include <camera/NdkCameraMetadata.h>
+#include <camera/NdkCameraMetadataTags.h>
+#include <camera/NdkCaptureRequest.h>
+
+#include <media/NdkImageReader.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+
+/*
+ *
+ * Defines and helpers.
+ *
+ */
+
+#define CAM_WIDTH 640
+#define CAM_HEIGHT 480
+#define CAM_MAX_IMAGES 4
+
+#define ACFS_LOOPER_ID 3
+
+//! Shortest sensor period we ask for; the queue clamps to the sensor's own minimum delay.
+#define IMU_RATE_USEC 2500
+
+
+/*!
+ * Sensor events and camera frames are stamped on the CLOCK_BOOTTIME base
+ * while the rest of Monado uses CLOCK_MONOTONIC. The two only drift apart
+ * while the device is suspended, so the offset is resampled on every call
+ * instead of being cached. Same helper as in android_sensors.c.
+ */
+static int64_t
+acfs_time_to_monotonic_ns(int64_t boottime_ns)
+{
+	struct timespec boot;
+	struct timespec mono;
+	if (clock_gettime(CLOCK_BOOTTIME, &boot) != 0 || clock_gettime(CLOCK_MONOTONIC, &mono) != 0) {
+		return boottime_ns;
+	}
+
+	int64_t offset_ns = (int64_t)(boot.tv_sec - mono.tv_sec) * 1000000000LL + (boot.tv_nsec - mono.tv_nsec);
+	return boottime_ns - offset_ns;
+}
+
+
+/*
+ *
+ * The frameserver struct.
+ *
+ */
+
+struct android_camera_fs
+{
+	struct xrt_fs base;
+	struct xrt_frame_node node;
+	struct xrt_frame_context *xfctx;
+
+	struct xrt_slam_sinks sinks;
+	bool is_running;
+
+	// Camera state, only valid while running.
+	ACameraManager *manager;
+	ACameraDevice *device;
+	ACameraCaptureSession *session;
+	ACaptureRequest *request;
+	ACameraOutputTarget *target;
+	ACaptureSessionOutput *session_output;
+	ACaptureSessionOutputContainer *outputs;
+	AImageReader *reader;
+
+	// IMU state.
+	struct os_thread_helper imu_thread;
+	struct os_mutex imu_lock;
+	struct xrt_vec3 last_accel;
+	bool have_accel;
+
+	// Throughput over the current reporting window, see acfs_report_stats.
+	int64_t stats_start_ns;
+	uint32_t frame_count;
+	uint32_t imu_count;
+};
+
+static struct android_camera_fs *
+android_camera_fs(struct xrt_fs *xfs)
+{
+	return (struct android_camera_fs *)xfs;
+}
+
+
+/*
+ *
+ * Camera callbacks.
+ *
+ */
+
+//! Rare and needed in the field, so these ignore the global log level.
+#define ACFS_INFO(...) U_LOG_IFL_I(U_LOGGING_INFO, __VA_ARGS__)
+
+/*!
+ * One line every five seconds with what is really reaching the tracker.
+ * The counters are touched from the camera and the IMU threads without a
+ * lock: they only feed this line.
+ */
+static void
+acfs_report_stats(struct android_camera_fs *acfs)
+{
+	int64_t now_ns = os_monotonic_get_ns();
+	if (acfs->stats_start_ns == 0) {
+		acfs->stats_start_ns = now_ns;
+		return;
+	}
+
+	double elapsed_s = time_ns_to_s(now_ns - acfs->stats_start_ns);
+	if (elapsed_s < 5.0) {
+		return;
+	}
+
+	ACFS_INFO("SLAM input: camera %.1f fps, IMU %.0f Hz", acfs->frame_count / elapsed_s,
+	          acfs->imu_count / elapsed_s);
+	acfs->stats_start_ns = now_ns;
+	acfs->frame_count = 0;
+	acfs->imu_count = 0;
+}
+
+static void
+on_device_disconnected(void *context, ACameraDevice *device)
+{
+	(void)context;
+	(void)device;
+	U_LOG_W("Android camera disconnected: another app took it or the system revoked it. No images for SLAM");
+}
+
+static void
+on_device_error(void *context, ACameraDevice *device, int error)
+{
+	(void)context;
+	(void)device;
+	// The NDK folds the platform's "camera disabled by policy" into ERROR_CAMERA_DEVICE.
+	U_LOG_E("Android camera error %d: no more images for SLAM. Android stops the camera of a process that is "
+	        "not in the foreground",
+	        error);
+}
+
+static void
+on_session_closed(void *context, ACameraCaptureSession *session)
+{
+	(void)context;
+	(void)session;
+}
+
+static void
+on_session_ready(void *context, ACameraCaptureSession *session)
+{
+	(void)context;
+	(void)session;
+}
+
+static void
+on_session_active(void *context, ACameraCaptureSession *session)
+{
+	(void)context;
+	(void)session;
+}
+
+static void
+on_image_available(void *context, AImageReader *reader)
+{
+	struct android_camera_fs *acfs = (struct android_camera_fs *)context;
+
+	AImage *image = NULL;
+	if (AImageReader_acquireNextImage(reader, &image) != AMEDIA_OK || image == NULL) {
+		return;
+	}
+
+	int32_t width = 0;
+	int32_t height = 0;
+	AImage_getWidth(image, &width);
+	AImage_getHeight(image, &height);
+
+	uint8_t *y_plane = NULL;
+	int y_len = 0;
+	int y_stride = 0;
+	AImage_getPlaneData(image, 0, &y_plane, &y_len);
+	AImage_getPlaneRowStride(image, 0, &y_stride);
+
+	int64_t timestamp = 0;
+	AImage_getTimestamp(image, &timestamp);
+
+	if (width == CAM_WIDTH && height == CAM_HEIGHT && y_plane != NULL && acfs->sinks.cams[0] != NULL) {
+		struct xrt_frame *xf = NULL;
+		u_frame_create_one_off(XRT_FORMAT_L8, CAM_WIDTH, CAM_HEIGHT, &xf);
+		if (xf != NULL) {
+			for (int row = 0; row < CAM_HEIGHT; row++) {
+				memcpy(xf->data + (size_t)row * xf->stride, y_plane + (size_t)row * (size_t)y_stride,
+				       CAM_WIDTH);
+			}
+			// The sensor timestamp marks the start of exposure; the
+			// calibration's time offset absorbs the constant part of
+			// the rolling-shutter readout (29 ms measured on device).
+			xf->timestamp = acfs_time_to_monotonic_ns(timestamp);
+			xf->source_timestamp = xf->timestamp;
+			xf->source_id = ANDROID_CAMERA_FS_SOURCE_ID;
+
+			xrt_sink_push_frame(acfs->sinks.cams[0], xf);
+			xrt_frame_reference(&xf, NULL);
+
+			acfs->frame_count++;
+			acfs_report_stats(acfs);
+		}
+	}
+
+	AImage_delete(image);
+}
+
+
+/*
+ *
+ * IMU thread.
+ *
+ */
+
+static void
+acfs_push_imu(struct android_camera_fs *acfs, const ASensorEvent *event)
+{
+	if (acfs->sinks.imus[0] == NULL) {
+		return;
+	}
+
+	os_mutex_lock(&acfs->imu_lock);
+	struct xrt_vec3 accel = acfs->last_accel;
+	bool have_accel = acfs->have_accel;
+	os_mutex_unlock(&acfs->imu_lock);
+
+	if (!have_accel) {
+		return;
+	}
+
+	struct xrt_imu_sample sample = {0};
+	sample.timestamp_ns = acfs_time_to_monotonic_ns(event->timestamp);
+	sample.accel_m_s2.x = (double)accel.x;
+	sample.accel_m_s2.y = (double)accel.y;
+	sample.accel_m_s2.z = (double)accel.z;
+	sample.gyro_rad_secs.x = (double)event->vector.x;
+	sample.gyro_rad_secs.y = (double)event->vector.y;
+	sample.gyro_rad_secs.z = (double)event->vector.z;
+
+	xrt_sink_push_imu(acfs->sinks.imus[0], &sample);
+	acfs->imu_count++;
+}
+
+static void *
+acfs_imu_thread(void *ptr)
+{
+	struct android_camera_fs *acfs = (struct android_camera_fs *)ptr;
+	static const int max_wait_milliseconds = 100;
+
+#if __ANDROID_API__ >= 26
+	ASensorManager *sensor_manager = ASensorManager_getInstanceForPackage(XRT_ANDROID_PACKAGE);
+#else
+	ASensorManager *sensor_manager = ASensorManager_getInstance();
+#endif
+
+	const ASensor *accelerometer = ASensorManager_getDefaultSensor(sensor_manager, ASENSOR_TYPE_ACCELEROMETER);
+	const ASensor *gyroscope = ASensorManager_getDefaultSensor(sensor_manager, ASENSOR_TYPE_GYROSCOPE);
+	if (accelerometer == NULL || gyroscope == NULL) {
+		U_LOG_E("Android camera frameserver: accelerometer or gyroscope missing");
+		return NULL;
+	}
+
+	ALooper *looper = ALooper_forThread();
+	if (looper == NULL) {
+		looper = ALooper_prepare(ALOOPER_PREPARE_ALLOW_NON_CALLBACKS);
+	}
+
+	ASensorEventQueue *event_queue =
+	    ASensorManager_createEventQueue(sensor_manager, looper, ACFS_LOOPER_ID, NULL, NULL);
+
+	int32_t accel_rate = MAX(IMU_RATE_USEC, ASensor_getMinDelay(accelerometer));
+	int32_t gyro_rate = MAX(IMU_RATE_USEC, ASensor_getMinDelay(gyroscope));
+	ASensorEventQueue_enableSensor(event_queue, accelerometer);
+	ASensorEventQueue_setEventRate(event_queue, accelerometer, accel_rate);
+	ASensorEventQueue_enableSensor(event_queue, gyroscope);
+	ASensorEventQueue_setEventRate(event_queue, gyroscope, gyro_rate);
+
+	while (os_thread_helper_is_running(&acfs->imu_thread)) {
+		int num_events = 0;
+		const int looper_id = ALooper_pollOnce(max_wait_milliseconds, NULL, &num_events, NULL);
+		if (looper_id != ACFS_LOOPER_ID || num_events <= 0) {
+			continue;
+		}
+
+		ASensorEvent event;
+		while (ASensorEventQueue_getEvents(event_queue, &event, 1) > 0) {
+			switch (event.type) {
+			case ASENSOR_TYPE_ACCELEROMETER: {
+				os_mutex_lock(&acfs->imu_lock);
+				acfs->last_accel.x = event.acceleration.x;
+				acfs->last_accel.y = event.acceleration.y;
+				acfs->last_accel.z = event.acceleration.z;
+				acfs->have_accel = true;
+				os_mutex_unlock(&acfs->imu_lock);
+				break;
+			}
+			case ASENSOR_TYPE_GYROSCOPE: acfs_push_imu(acfs, &event); break;
+			default: break;
+			}
+		}
+	}
+
+	ASensorEventQueue_disableSensor(event_queue, accelerometer);
+	ASensorEventQueue_disableSensor(event_queue, gyroscope);
+	ASensorManager_destroyEventQueue(sensor_manager, event_queue);
+	return NULL;
+}
+
+
+
+/*
+ *
+ * Camera open/close.
+ *
+ */
+
+static bool
+acfs_pick_back_camera(struct android_camera_fs *acfs, char **out_id)
+{
+	ACameraIdList *id_list = NULL;
+	if (ACameraManager_getCameraIdList(acfs->manager, &id_list) != ACAMERA_OK) {
+		return false;
+	}
+
+	bool found = false;
+	for (int i = 0; i < id_list->numCameras && !found; i++) {
+		ACameraMetadata *chars = NULL;
+		if (ACameraManager_getCameraCharacteristics(acfs->manager, id_list->cameraIds[i], &chars) != ACAMERA_OK) {
+			continue;
+		}
+		ACameraMetadata_const_entry entry = {0};
+		if (ACameraMetadata_getConstEntry(chars, ACAMERA_LENS_FACING, &entry) == ACAMERA_OK &&
+		    entry.count >= 1 && entry.data.u8[0] == ACAMERA_LENS_FACING_BACK) {
+			*out_id = strdup(id_list->cameraIds[i]);
+			found = *out_id != NULL;
+		}
+		ACameraMetadata_free(chars);
+	}
+
+	ACameraManager_deleteCameraIdList(id_list);
+	return found;
+}
+
+static bool
+acfs_meta_has_u8(const ACameraMetadata *chars, uint32_t tag, uint8_t value)
+{
+	ACameraMetadata_const_entry entry = {0};
+	if (ACameraMetadata_getConstEntry(chars, tag, &entry) != ACAMERA_OK) {
+		return false;
+	}
+	for (uint32_t i = 0; i < entry.count; i++) {
+		if (entry.data.u8[i] == value) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+acfs_meta_has_fps_range(const ACameraMetadata *chars, int32_t low, int32_t high)
+{
+	ACameraMetadata_const_entry entry = {0};
+	if (ACameraMetadata_getConstEntry(chars, ACAMERA_CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES, &entry) !=
+	    ACAMERA_OK) {
+		return false;
+	}
+	for (uint32_t i = 0; i + 1 < entry.count; i += 2) {
+		if (entry.data.i32[i] == low && entry.data.i32[i + 1] == high) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*!
+ * Makes the stream usable for tracking, the same way the sensor recorder
+ * the calibration was made with does: a steady 30 fps, no electronic or
+ * optical stabilisation (both move the image independently of the IMU) and
+ * focus fixed at infinity (autofocus changes the focal length under the
+ * calibration). Each control is only set when the camera lists it.
+ */
+static void
+acfs_configure_request(struct android_camera_fs *acfs, const ACameraMetadata *chars)
+{
+	if (acfs_meta_has_fps_range(chars, 30, 30)) {
+		const int32_t fps_range[2] = {30, 30};
+		ACaptureRequest_setEntry_i32(acfs->request, ACAMERA_CONTROL_AE_TARGET_FPS_RANGE, 2, fps_range);
+	}
+
+	if (acfs_meta_has_u8(chars, ACAMERA_CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES,
+	                     ACAMERA_CONTROL_VIDEO_STABILIZATION_MODE_OFF)) {
+		const uint8_t off = ACAMERA_CONTROL_VIDEO_STABILIZATION_MODE_OFF;
+		ACaptureRequest_setEntry_u8(acfs->request, ACAMERA_CONTROL_VIDEO_STABILIZATION_MODE, 1, &off);
+	}
+
+	if (acfs_meta_has_u8(chars, ACAMERA_LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION,
+	                     ACAMERA_LENS_OPTICAL_STABILIZATION_MODE_OFF)) {
+		const uint8_t off = ACAMERA_LENS_OPTICAL_STABILIZATION_MODE_OFF;
+		ACaptureRequest_setEntry_u8(acfs->request, ACAMERA_LENS_OPTICAL_STABILIZATION_MODE, 1, &off);
+	}
+
+	bool fixed_focus = acfs_meta_has_u8(chars, ACAMERA_CONTROL_AF_AVAILABLE_MODES, ACAMERA_CONTROL_AF_MODE_OFF);
+	if (fixed_focus) {
+		const uint8_t off = ACAMERA_CONTROL_AF_MODE_OFF;
+		const float infinity_diopters = 0.0f;
+		ACaptureRequest_setEntry_u8(acfs->request, ACAMERA_CONTROL_AF_MODE, 1, &off);
+		ACaptureRequest_setEntry_float(acfs->request, ACAMERA_LENS_FOCUS_DISTANCE, 1, &infinity_diopters);
+	}
+
+	ACFS_INFO("Android camera for SLAM: %dx%d, focus %s", CAM_WIDTH, CAM_HEIGHT,
+	          fixed_focus ? "fixed at infinity" : "left to the camera");
+}
+
+static bool
+acfs_start_camera(struct android_camera_fs *acfs)
+{
+	acfs->manager = ACameraManager_create();
+	if (acfs->manager == NULL) {
+		U_LOG_E("Android camera frameserver: ACameraManager_create failed");
+		return false;
+	}
+
+	char *camera_id = NULL;
+	if (!acfs_pick_back_camera(acfs, &camera_id)) {
+		U_LOG_E("Android camera frameserver: no back camera found");
+		return false;
+	}
+
+	static AImageReader_ImageListener listener;
+	listener.context = acfs;
+	listener.onImageAvailable = on_image_available;
+
+	media_status_t mret = AImageReader_new(CAM_WIDTH, CAM_HEIGHT, AIMAGE_FORMAT_YUV_420_888, CAM_MAX_IMAGES,
+	                                       &acfs->reader);
+	if (mret != AMEDIA_OK) {
+		U_LOG_E("Android camera frameserver: AImageReader_new failed (%d)", (int)mret);
+		free(camera_id);
+		return false;
+	}
+	AImageReader_setImageListener(acfs->reader, &listener);
+
+	ANativeWindow *window = NULL;
+	AImageReader_getWindow(acfs->reader, &window);
+
+	static ACameraDevice_StateCallbacks device_callbacks;
+	device_callbacks.context = acfs;
+	device_callbacks.onDisconnected = on_device_disconnected;
+	device_callbacks.onError = on_device_error;
+
+	ACameraMetadata *chars = NULL;
+	ACameraManager_getCameraCharacteristics(acfs->manager, camera_id, &chars);
+
+	camera_status_t cret = ACameraManager_openCamera(acfs->manager, camera_id, &device_callbacks, &acfs->device);
+	free(camera_id);
+	if (cret != ACAMERA_OK || acfs->device == NULL) {
+		if (chars != NULL) {
+			ACameraMetadata_free(chars);
+		}
+		U_LOG_E("Android camera frameserver: openCamera failed (%d); camera permission missing?", (int)cret);
+		return false;
+	}
+
+	ACaptureSessionOutputContainer_create(&acfs->outputs);
+	ACaptureSessionOutput_create(window, &acfs->session_output);
+	ACaptureSessionOutputContainer_add(acfs->outputs, acfs->session_output);
+
+	static ACameraCaptureSession_stateCallbacks session_callbacks;
+	session_callbacks.context = acfs;
+	session_callbacks.onClosed = on_session_closed;
+	session_callbacks.onReady = on_session_ready;
+	session_callbacks.onActive = on_session_active;
+
+	cret = ACameraDevice_createCaptureSession(acfs->device, acfs->outputs, &session_callbacks, &acfs->session);
+	if (cret != ACAMERA_OK || acfs->session == NULL) {
+		U_LOG_E("Android camera frameserver: createCaptureSession failed (%d)", (int)cret);
+		if (chars != NULL) {
+			ACameraMetadata_free(chars);
+		}
+		return false;
+	}
+
+	cret = ACameraDevice_createCaptureRequest(acfs->device, TEMPLATE_RECORD, &acfs->request);
+	if (cret != ACAMERA_OK || acfs->request == NULL) {
+		U_LOG_E("Android camera frameserver: createCaptureRequest failed (%d)", (int)cret);
+		if (chars != NULL) {
+			ACameraMetadata_free(chars);
+		}
+		return false;
+	}
+	if (chars != NULL) {
+		acfs_configure_request(acfs, chars);
+		ACameraMetadata_free(chars);
+	}
+	ACameraOutputTarget_create(window, &acfs->target);
+	ACaptureRequest_addTarget(acfs->request, acfs->target);
+
+	cret = ACameraCaptureSession_setRepeatingRequest(acfs->session, NULL, 1, &acfs->request, NULL);
+	if (cret != ACAMERA_OK) {
+		U_LOG_E("Android camera frameserver: setRepeatingRequest failed (%d)", (int)cret);
+		return false;
+	}
+
+	return true;
+}
+
+static void
+acfs_stop_camera(struct android_camera_fs *acfs)
+{
+	if (acfs->session != NULL) {
+		ACameraCaptureSession_stopRepeating(acfs->session);
+		ACameraCaptureSession_abortCaptures(acfs->session);
+		ACameraCaptureSession_close(acfs->session);
+		acfs->session = NULL;
+	}
+	if (acfs->request != NULL) {
+		ACaptureRequest_free(acfs->request);
+		acfs->request = NULL;
+	}
+	if (acfs->target != NULL) {
+		ACameraOutputTarget_free(acfs->target);
+		acfs->target = NULL;
+	}
+	if (acfs->session_output != NULL) {
+		ACaptureSessionOutput_free(acfs->session_output);
+		acfs->session_output = NULL;
+	}
+	if (acfs->outputs != NULL) {
+		ACaptureSessionOutputContainer_free(acfs->outputs);
+		acfs->outputs = NULL;
+	}
+	if (acfs->device != NULL) {
+		ACameraDevice_close(acfs->device);
+		acfs->device = NULL;
+	}
+	if (acfs->reader != NULL) {
+		AImageReader_setImageListener(acfs->reader, NULL);
+		AImageReader_delete(acfs->reader);
+		acfs->reader = NULL;
+	}
+	if (acfs->manager != NULL) {
+		ACameraManager_delete(acfs->manager);
+		acfs->manager = NULL;
+	}
+}
+
+static bool
+acfs_start(struct android_camera_fs *acfs)
+{
+	if (acfs->is_running) {
+		return true;
+	}
+	if (!acfs_start_camera(acfs)) {
+		acfs_stop_camera(acfs);
+		return false;
+	}
+	os_thread_helper_start(&acfs->imu_thread, acfs_imu_thread, acfs);
+	acfs->is_running = true;
+	return true;
+}
+
+static void
+acfs_stop(struct android_camera_fs *acfs)
+{
+	if (!acfs->is_running) {
+		return;
+	}
+	acfs->is_running = false;
+	os_thread_helper_stop_and_wait(&acfs->imu_thread);
+	acfs_stop_camera(acfs);
+}
+
+
+/*
+ *
+ * Frameserver functions.
+ *
+ */
+
+static xrt_result_t
+acfs_enumerate_modes(struct xrt_fs *xfs, struct xrt_fs_mode **out_modes, uint32_t *out_count)
+{
+	(void)xfs;
+
+	struct xrt_fs_mode *modes = U_TYPED_ARRAY_CALLOC(struct xrt_fs_mode, 1);
+	if (modes == NULL) {
+		return XRT_ERROR_ALLOCATION;
+	}
+
+	modes[0].width = CAM_WIDTH;
+	modes[0].height = CAM_HEIGHT;
+	modes[0].format = XRT_FORMAT_L8;
+	modes[0].stereo_format = XRT_STEREO_FORMAT_NONE;
+
+	*out_modes = modes;
+	*out_count = 1;
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+acfs_configure_capture(struct xrt_fs *xfs, struct xrt_fs_capture_parameters *cp)
+{
+	(void)xfs;
+	(void)cp;
+	// No adjustable parameters yet; the mode is fixed.
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+acfs_stream_start(struct xrt_fs *xfs,
+                  struct xrt_frame_sink *xs,
+                  enum xrt_fs_capture_type capture_type,
+                  uint32_t descriptor_index)
+{
+	(void)xfs;
+	(void)xs;
+	(void)capture_type;
+	(void)descriptor_index;
+	// Only the SLAM stream is meaningful for this source.
+	return XRT_ERROR_NOT_IMPLEMENTED;
+}
+
+static xrt_result_t
+acfs_slam_stream_start(struct xrt_fs *xfs, struct xrt_slam_sinks *sinks)
+{
+	struct android_camera_fs *acfs = android_camera_fs(xfs);
+	acfs->sinks = *sinks;
+	return acfs_start(acfs) ? XRT_SUCCESS : XRT_ERROR_DEVICE_CREATION_FAILED;
+}
+
+static xrt_result_t
+acfs_stream_stop(struct xrt_fs *xfs)
+{
+	struct android_camera_fs *acfs = android_camera_fs(xfs);
+	acfs_stop(acfs);
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+acfs_is_running(struct xrt_fs *xfs, bool *out_is_running)
+{
+	struct android_camera_fs *acfs = android_camera_fs(xfs);
+	*out_is_running = acfs->is_running;
+	return XRT_SUCCESS;
+}
+
+
+/*
+ *
+ * Frame node functions.
+ *
+ */
+
+static void
+acfs_break_apart(struct xrt_frame_node *node)
+{
+	struct android_camera_fs *acfs = container_of(node, struct android_camera_fs, node);
+	acfs_stop(acfs);
+}
+
+static void
+acfs_destroy(struct xrt_frame_node *node)
+{
+	struct android_camera_fs *acfs = container_of(node, struct android_camera_fs, node);
+	acfs_stop(acfs);
+	os_thread_helper_destroy(&acfs->imu_thread);
+	os_mutex_destroy(&acfs->imu_lock);
+	free(acfs);
+}
+
+
+/*
+ *
+ * Create.
+ *
+ */
+
+struct xrt_fs *
+android_camera_fs_create(struct xrt_frame_context *xfctx)
+{
+	struct android_camera_fs *acfs = U_TYPED_CALLOC(struct android_camera_fs);
+	if (acfs == NULL) {
+		return NULL;
+	}
+
+	acfs->xfctx = xfctx;
+	os_mutex_init(&acfs->imu_lock);
+	os_thread_helper_init(&acfs->imu_thread);
+
+	struct xrt_fs *xfs = &acfs->base;
+	u_frameserver_populate_function_pointers(xfs);
+	xfs->enumerate_modes = acfs_enumerate_modes;
+	xfs->configure_capture = acfs_configure_capture;
+	xfs->stream_start = acfs_stream_start;
+	xfs->slam_stream_start = acfs_slam_stream_start;
+	xfs->stream_stop = acfs_stream_stop;
+	xfs->is_running = acfs_is_running;
+
+	(void)snprintf(xfs->name, sizeof(xfs->name), "Android Camera");
+	(void)snprintf(xfs->product, sizeof(xfs->product), "Android Camera Product");
+	(void)snprintf(xfs->manufacturer, sizeof(xfs->manufacturer), "Android");
+	(void)snprintf(xfs->serial, sizeof(xfs->serial), "Android Camera Serial");
+	xfs->source_id = ANDROID_CAMERA_FS_SOURCE_ID;
+
+	struct xrt_frame_node *xfn = &acfs->node;
+	xfn->break_apart = acfs_break_apart;
+	xfn->destroy = acfs_destroy;
+
+	xrt_frame_context_add(xfctx, &acfs->node);
+
+	U_LOG_I("Android camera frameserver created");
+	return xfs;
+}
