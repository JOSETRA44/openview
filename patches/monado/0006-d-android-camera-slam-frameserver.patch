 DEBUG_GET_ONCE_NUM_OPTION(rs_source_index, "RS_SOURCE_INDEX", -1)
 #endif
 
+#ifdef XRT_BUILD_DRIVER_ANDROID
+#include "android/android_camera_fs.h"
+#include "util/u_debug.h"
+#include <xrt/xrt_config_android.h>
+#include <unistd.h>
+// Off until 6DoF tracks on a device: setprop debug.xrt.ANDROID_SLAM_CAMERA true
+DEBUG_GET_ONCE_BOOL_OPTION(android_slam_camera, "ANDROID_SLAM_CAMERA", true)
+
+#ifdef XRT_FEATURE_SLAM
+/*!
+ * The VIT backend ends the whole process when its configuration or the
+ * calibration it points to cannot be read, and a runtime without head
+ * tracking is worse than one with 3DoF. So check every file up front: the
+ * config is a list of `key="path"` lines.
+ */
+static bool
+p_android_slam_config_is_readable(const char *config_path)
+{
+	FILE *file = fopen(config_path, "r");
+	if (file == NULL) {
+		U_LOG_W("SLAM config '%s' is missing", config_path);
+		return false;
+	}
+
+	bool ok = true;
+	int path_count = 0;
+	char line[512];
+	while (ok && fgets(line, sizeof(line), file) != NULL) {
+		char *start = strchr(line, '"');
+		char *end = start != NULL ? strchr(start + 1, '"') : NULL;
+		if (end == NULL) {
+			continue;
+		}
+		*end = '\0';
+		path_count++;
+		if (access(start + 1, R_OK) != 0) {
+			U_LOG_W("SLAM config points to '%s', which cannot be read", start + 1);
+			ok = false;
+		}
+	}
+	fclose(file);
+
+	return ok && path_count > 0;
+}
+#endif
+#endif
