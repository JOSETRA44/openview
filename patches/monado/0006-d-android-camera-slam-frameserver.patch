+	// SLAM tracker with Android camera frameserver
+
+#ifdef XRT_BUILD_DRIVER_ANDROID
+	if (debug_get_bool_option_android_slam_camera()) {
+#ifdef XRT_FEATURE_SLAM
+		// The backend ships inside the runtime APK, so dlopen finds it by
+		// soname in the app's native library directory. The app extracts
+		// the SLAM config into its files dir at a fixed path on startup.
+		static char slam_config_path[256];
+		(void)snprintf(slam_config_path, sizeof(slam_config_path), "/data/data/%s/files/slam/slam_config.txt",
+		               XRT_ANDROID_PACKAGE);
+		if (!p_android_slam_config_is_readable(slam_config_path)) {
+			U_LOG_W("SLAM tracking is not set up, the Android device will only track orientation");
+			return false;
+		}
+
+		struct xrt_slam_sinks empty_sinks = {0};
+		struct xrt_slam_sinks *sinks = &empty_sinks;
+
+		xrt_prober_open_video_device(&fact->p->base, NULL, &fact->xfctx, &fact->xfs);
+		if (fact->xfs == NULL) {
+			return false;
+		}
+		assert(fact->xfs->source_id == ANDROID_CAMERA_FS_SOURCE_ID &&
+		       "xfs is not the Android camera, unsynced open_video_device?");
+
+		struct t_slam_tracker_config st_config;
+		t_slam_fill_default_config(&st_config);
+		st_config.cam_count = 1;
+		st_config.vit_system_library_path = "libbasalt.so";
+		st_config.slam_config = slam_config_path;
+
+		// Samples are only handed to the backend while this is set, and on
+		// a phone nothing else sets it: there is no debug UI and no
+		// environment. Without it the tracker never sees a frame.
+		st_config.submit_from_start = true;
+
+		// The device blends the estimates with its own gyro fusion, so it
+		// wants them as the backend made them, not extrapolated.
+		st_config.prediction = SLAM_PRED_NONE;
+
+		int ret = t_slam_create(&fact->xfctx, &st_config, &fact->xts, &sinks);
+		if (ret != 0) {
+			// Do not open the camera for a tracker that does not exist.
+			U_LOG_W("Unable to initialize SLAM tracking, the Android device will only track orientation");
+			fact->xts = NULL;
+			return false;
+		}
+
+		if (xrt_fs_slam_stream_start(fact->xfs, sinks) != XRT_SUCCESS) {
+			U_LOG_W("The camera could not be started, SLAM will have no images until it can");
+		}
+
+		return true;
+#else
+		U_LOG_W("SLAM tracking support is disabled, the Android device will only track orientation");
+		return false;
+#endif
+	}
+#endif
