+# The Android app build points OPENCV_ANDROID_SDK_DIR at an unpacked
+# OpenCV Android SDK; its config package lives per-ABI inside it.
+if(ANDROID AND OPENCV_ANDROID_SDK_DIR)
+	set(OpenCV_DIR "${OPENCV_ANDROID_SDK_DIR}/sdk/native/jni/abi-${ANDROID_ABI}")
+endif()
+
 find_package(OpenCV QUIET COMPONENTS ${OPENCV_COMMON_COMPONENTS} calib3d features2d CONFIG)
 if(NOT OpenCV_FOUND)
 	find_package(OpenCV COMPONENTS ${OPENCV_COMMON_COMPONENTS} calib features CONFIG)
@@ -308,7 +314,7 @@ option_with_deps(XRT_FEATURE_RENDERDOC "Enable RenderDoc API" DEPENDS "RT_LIBRAR
