+/*!
+ * Sensor events are stamped on the CLOCK_BOOTTIME base while the rest of
+ * Monado, including the times poses are requested for, uses CLOCK_MONOTONIC.
+ * The two only drift apart while the device is suspended, so the offset is
+ * resampled on every call instead of being cached.
+ */
+static int64_t
+android_sensor_time_to_monotonic_ns(int64_t sensor_timestamp_ns)
+{
+	struct timespec boot;
+	struct timespec mono;
+	if (clock_gettime(CLOCK_BOOTTIME, &boot) != 0 || clock_gettime(CLOCK_MONOTONIC, &mono) != 0) {
+		return sensor_timestamp_ns;
+	}
+
+	int64_t offset_ns = (int64_t)(boot.tv_sec - mono.tv_sec) * 1000000000LL + (boot.tv_nsec - mono.tv_nsec);
+	return sensor_timestamp_ns - offset_ns;
+}
+
+/*!
+ * Decides which time the head pose is actually sampled at, given when the
+ * caller wants it. Gyro extrapolation assumes constant angular velocity, so
+ * its error grows with the horizon, and callers can ask for arbitrary times.
+ *
+ * @param d               For device properties such as the frame interval.
+ * @param now_ns          Current monotonic time.
+ * @param at_timestamp_ns Time the pose was requested for.
+ * @return Time to query the relation history with.
+ */
+static int64_t
+android_limit_prediction_ns(const struct android_device *d, int64_t now_ns, int64_t at_timestamp_ns)
+{
+	/*
+	 * A frame takes about two periods to cross SurfaceFlinger, on top of
+	 * app render and composition, so apps legitimately ask for poses up to
+	 * four periods ahead (measured: 36 to 64 ms at 60 Hz). Five gives some
+	 * margin. The error of extrapolating with constant angular velocity
+	 * grows with the square of the horizon, so anything further out (a
+	 * paused app, a bogus timestamp) is not worth following. The fixed
+	 * bounds keep the limit sane across 60 to 144 Hz panels.
+	 */
+	int64_t horizon_ns = 5 * (int64_t)d->base.hmd->screens[0].nominal_frame_interval_ns;
+	horizon_ns = CLAMP(horizon_ns, 40 * U_TIME_1MS_IN_NS, 100 * U_TIME_1MS_IN_NS);
+
+	return MIN(at_timestamp_ns, now_ns + horizon_ns);
+}
+
+/*!
+ * Logs one line of timing statistics per second while debug logging is on.
+ * A summary instead of per-event traces because some vendors drop every
+ * log line below info, and sensors run at hundreds of events per second.
+ * Call with the lock held.
+ */
+static void
+android_stats_report_locked(struct android_device *d, int64_t now_ns)
+{
+	if (d->log_level > U_LOGGING_DEBUG || now_ns - d->stats.window_start_ns < U_TIME_1S_IN_NS) {
+		return;
+	}
+
+	if (d->stats.gyro_count > 0 && d->stats.pose_count > 0) {
+		ANDROID_INFO(d,
+		             "gyro %u Hz, sample age avg %" PRId64 " us max %" PRId64 " us; poses %u, horizon min %" PRId64
+		             " avg %" PRId64 " max %" PRId64 " us, limited %u",
+		             d->stats.gyro_count, d->stats.gyro_age_sum_ns / d->stats.gyro_count / 1000,
+		             d->stats.gyro_age_max_ns / 1000, d->stats.pose_count, d->stats.horizon_min_ns / 1000,
+		             d->stats.horizon_sum_ns / d->stats.pose_count / 1000, d->stats.horizon_max_ns / 1000,
+		             d->stats.limited_count);
+	}
+
+	U_ZERO(&d->stats);
+	d->stats.window_start_ns = now_ns;
+	d->stats.horizon_min_ns = INT64_MAX;
+	d->stats.horizon_max_ns = INT64_MIN;
+}
