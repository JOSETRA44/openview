+		                                                     XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+		                                                     XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT);
+		rel.pose.orientation = d->fusion.rot;
