+/*
+ *
+ * SLAM tracker fusion.
+ *
+ */
+
+//! Messages about the tracker are rare and needed in the field, so they ignore the driver's log level.
+#define ANDROID_SLAM_LOG(...) U_LOG_IFL_I(U_LOGGING_INFO, __VA_ARGS__)
+
+//! A tracker that has not produced a new pose for this long is considered stalled.
+#define ANDROID_SLAM_STALE_NS (400 * U_TIME_1MS_IN_NS)
+//! Faster than any head moves; the estimate has diverged.
+#define ANDROID_SLAM_MAX_SPEED_M_S 6.0f
+//! Plausible new poses in a row before the tracker is trusted.
+#define ANDROID_SLAM_GOOD_POSES_TO_TRACK 15
+//! Time constant of the yaw correction.
+#define ANDROID_SLAM_YAW_TAU_S 4.0f
+//! Above this angular speed the tracker's (late) orientation is not compared with the fusion's.
+#define ANDROID_SLAM_YAW_MAX_RATE_RAD_S 0.5f
+
+static float
+android_wrap_angle(float a)
+{
+	while (a > (float)M_PI) {
+		a -= 2.0f * (float)M_PI;
+	}
+	while (a < -(float)M_PI) {
+		a += 2.0f * (float)M_PI;
+	}
+	return a;
+}
+
+//! Heading of an orientation: the rotation about +Y of its right vector.
+static float
+android_yaw_of(const struct xrt_quat *q)
+{
+	const struct xrt_vec3 right = {1.0f, 0.0f, 0.0f};
+	struct xrt_vec3 r;
+	math_quat_rotate_vec3(q, &right, &r);
+	return atan2f(-r.z, r.x);
+}
+
+static struct xrt_quat
+android_yaw_quat(float yaw)
+{
+	struct xrt_quat q = {0.0f, sinf(yaw * 0.5f), 0.0f, cosf(yaw * 0.5f)};
+	return q;
+}
+
+static struct xrt_vec3
+android_yaw_rotate(float yaw, const struct xrt_vec3 *v)
+{
+	const float c = cosf(yaw);
+	const float s = sinf(yaw);
+	struct xrt_vec3 out = {c * v->x + s * v->z, v->y, -s * v->x + c * v->z};
+	return out;
+}
+
+/*!
+ * The tracker reports the pose of the IMU, in the phone's own sensor axes
+ * (the frameserver does not permute them), in a world with Z up. The device
+ * reports the pose of the head, in the axes the 3DoF fusion uses (the sensor
+ * axes turned a quarter turn about Z for landscape, see the sensor callback),
+ * in a world with Y up.
+ */
+static void
+android_slam_to_output_convention(const struct xrt_pose *slam, struct xrt_pose *out)
+{
+	// Minus a quarter turn about X: Z up to Y up.
+	const struct xrt_quat world_y_up = {-0.70710678f, 0.0f, 0.0f, 0.70710678f};
+	// Minus a quarter turn about Z: head axes expressed in sensor axes.
+	const struct xrt_quat sensor_from_head = {0.0f, 0.0f, -0.70710678f, 0.70710678f};
+
+	struct xrt_quat tmp;
+	math_quat_rotate(&world_y_up, &slam->orientation, &tmp);
+	math_quat_rotate(&tmp, &sensor_from_head, &out->orientation);
+	math_quat_normalize(&out->orientation);
+
+	out->position.x = slam->position.x;
+	out->position.y = slam->position.z;
+	out->position.z = -slam->position.y;
+}
+
+static bool
+android_pose_is_finite(const struct xrt_pose *p)
+{
+	return isfinite(p->position.x) && isfinite(p->position.y) && isfinite(p->position.z) &&
+	       isfinite(p->orientation.x) && isfinite(p->orientation.y) && isfinite(p->orientation.z) &&
+	       isfinite(p->orientation.w);
+}
+
+static void
+android_slam_stop_tracking_locked(struct android_device *d, const char *why)
+{
+	if (d->slam_state.tracking) {
+		ANDROID_SLAM_LOG("SLAM tracking lost (%s): holding position, orientation stays on the IMU", why);
+	}
+	d->slam_state.tracking = false;
+	d->slam_state.good_count = 0;
+}
