+/*!
+ * Combines the tracker with the 3DoF fusion. Call with slam_state.lock held.
+ *
+ * Orientation always comes from the gyro fusion, which is sampled at
+ * hundreds of hertz and predicted to the display time; the tracker only
+ * steers its heading, slowly, so vision removes the gyro's yaw drift without
+ * adding the camera's latency to head rotation. Position comes from the
+ * tracker. The tracker's world is aligned to the output world, in heading
+ * and translation, each time tracking starts, so starting, losing and
+ * regaining tracking never makes the view jump.
+ *
+ * @param fusion_rel The 3DoF relation for the requested time, updated in place.
+ */
+static void
+android_slam_update_locked(struct android_device *d,
+                           int64_t at_timestamp_ns,
+                           int64_t now_ns,
+                           struct xrt_space_relation *fusion_rel)
+{
+	struct xrt_space_relation slam_rel = XRT_SPACE_RELATION_ZERO;
+	xrt_tracked_slam_get_tracked_pose(d->slam, at_timestamp_ns, &slam_rel);
+
+	const enum xrt_space_relation_flags tracked_bits =
+	    (enum xrt_space_relation_flags)(XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+	                                    XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	bool have_pose =
+	    (slam_rel.relation_flags & tracked_bits) == tracked_bits && android_pose_is_finite(&slam_rel.pose);
+
+	struct xrt_pose pose = XRT_POSE_IDENTITY;
+	bool is_new = false;
+	if (have_pose) {
+		android_slam_to_output_convention(&slam_rel.pose, &pose);
+
+		// The tracker reports no timestamps here; a pose that differs from the last one is a new estimate.
+		is_new = !d->slam_state.have_last_pose ||
+		         memcmp(&pose, &d->slam_state.last_pose, sizeof(pose)) != 0;
+	}
+
+	if (is_new) {
+		bool plausible = true;
+		if (d->slam_state.have_last_pose) {
+			struct xrt_vec3 delta = m_vec3_sub(pose.position, d->slam_state.last_pose.position);
+			float dt_s = (float)time_ns_to_s(now_ns - d->slam_state.last_change_ns);
+			// Poses arrive in bursts, so the interval is floored at one camera frame.
+			plausible = m_vec3_len(delta) / MAX(dt_s, 0.033f) < ANDROID_SLAM_MAX_SPEED_M_S;
+		}
+
+		d->slam_state.last_pose = pose;
+		d->slam_state.have_last_pose = true;
+		d->slam_state.last_change_ns = now_ns;
+		d->slam_state.new_pose_count++;
+
+		if (!plausible) {
+			android_slam_stop_tracking_locked(d, "implausible jump");
+		} else if (!d->slam_state.tracking &&
+		           ++d->slam_state.good_count >= ANDROID_SLAM_GOOD_POSES_TO_TRACK) {
+			// Align the tracker's world so that this pose lands on what is being reported right now.
+			struct xrt_quat correction = android_yaw_quat(d->slam_state.yaw_correction);
+			struct xrt_quat corrected;
+			math_quat_rotate(&correction, &fusion_rel->pose.orientation, &corrected);
+
+			d->slam_state.align_yaw =
+			    android_wrap_angle(android_yaw_of(&corrected) - android_yaw_of(&pose.orientation));
+			struct xrt_vec3 rotated = android_yaw_rotate(d->slam_state.align_yaw, &pose.position);
+			d->slam_state.align_pos = m_vec3_sub(d->slam_state.position, rotated);
+			d->slam_state.tracking = true;
+			d->slam_state.last_correction_ns = now_ns;
+			ANDROID_SLAM_LOG("SLAM tracking started: 6DoF poses");
+		}
+	} else if (d->slam_state.tracking && now_ns - d->slam_state.last_change_ns > ANDROID_SLAM_STALE_NS) {
+		android_slam_stop_tracking_locked(d, "no new poses");
+	}
+
+	if (d->slam_state.tracking) {
+		struct xrt_vec3 rotated =
+		    android_yaw_rotate(d->slam_state.align_yaw, &d->slam_state.last_pose.position);
+		d->slam_state.position = m_vec3_add(rotated, d->slam_state.align_pos);
+
+		// Steer the fusion's heading towards the tracker's, only on a new estimate and
+		// while the head is nearly still: the tracker's orientation is a camera frame
+		// or more old, the fusion's is predicted.
+		if (is_new) {
+			float dt_s = (float)time_ns_to_s(now_ns - d->slam_state.last_correction_ns);
+			d->slam_state.last_correction_ns = now_ns;
+			if (dt_s > 0.0f && dt_s < 1.0f &&
+			    m_vec3_len(fusion_rel->angular_velocity) < ANDROID_SLAM_YAW_MAX_RATE_RAD_S) {
+				float slam_yaw = d->slam_state.align_yaw +
+				                 android_yaw_of(&d->slam_state.last_pose.orientation);
+				float fusion_yaw =
+				    d->slam_state.yaw_correction + android_yaw_of(&fusion_rel->pose.orientation);
+				float error = android_wrap_angle(slam_yaw - fusion_yaw);
+				float gain = 1.0f - expf(-dt_s / ANDROID_SLAM_YAW_TAU_S);
+				d->slam_state.yaw_correction =
+				    android_wrap_angle(d->slam_state.yaw_correction + gain * error);
+			}
+		}
+	}
+
+	// Apply the heading correction to orientation and angular velocity alike.
+	struct xrt_quat correction = android_yaw_quat(d->slam_state.yaw_correction);
+	struct xrt_quat corrected;
+	math_quat_rotate(&correction, &fusion_rel->pose.orientation, &corrected);
+	math_quat_normalize(&corrected);
+	fusion_rel->pose.orientation = corrected;
+	fusion_rel->angular_velocity = android_yaw_rotate(d->slam_state.yaw_correction, &fusion_rel->angular_velocity);
+	fusion_rel->pose.position = d->slam_state.position;
+
+	if (d->slam_state.tracking) {
+		fusion_rel->relation_flags = (enum xrt_space_relation_flags)(fusion_rel->relation_flags |
+		                                                             XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	}
+
+	if (now_ns - d->slam_state.last_log_ns > 5 * (int64_t)U_TIME_1S_IN_NS) {
+		if (d->slam_state.last_log_ns != 0) {
+			const char *state = d->slam_state.tracking
+			                        ? "tracking"
+			                        : (d->slam_state.have_last_pose ? "not trusted" : "no poses yet");
+			ANDROID_SLAM_LOG(
+			    "SLAM status: %s, %u new poses in 5 s, position %.2f %.2f %.2f m, yaw correction %.1f deg",
+			    state, d->slam_state.new_pose_count, d->slam_state.position.x, d->slam_state.position.y,
+			    d->slam_state.position.z, d->slam_state.yaw_correction * 180.0f / (float)M_PI);
+		}
+		d->slam_state.last_log_ns = now_ns;
+		d->slam_state.new_pose_count = 0;
+	}
+}
