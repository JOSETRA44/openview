diff --git a/src/xrt/drivers/android/android_sensors.c b/src/xrt/drivers/android/android_sensors.c
index e35fb385a..fb9a634e7 100644
--- a/src/xrt/drivers/android/android_sensors.c
+++ b/src/xrt/drivers/android/android_sensors.c
@@ -14,6 +14,9 @@
 
 #include "android_sensors.h"
 
+#include "xrt/xrt_prober.h"
+#include "xrt/xrt_tracking.h"
+
 #include "util/u_debug.h"
 #include "util/u_device.h"
 #include "util/u_distortion_mesh.h"
@@ -314,10 +317,24 @@ android_device_get_tracked_pose(struct xrt_device *xdev,
                                 int64_t at_timestamp_ns,
                                 struct xrt_space_relation *out_relation)
 {
-	(void)at_timestamp_ns;
-
 	struct android_device *d = android_device(xdev);
 
+	// Prefer the SLAM tracker (6DoF) whenever it is actually tracking;
+	// fall back to the 3DoF sensor fusion otherwise, e.g. while the
+	// tracker warms up or after it loses the scene.
+	if (d->slam != NULL) {
+		struct xrt_space_relation slam_relation = XRT_SPACE_RELATION_ZERO;
+		xrt_tracked_slam_get_tracked_pose(d->slam, at_timestamp_ns, &slam_relation);
+
+		const enum xrt_space_relation_flags tracked_bits =
+		    (enum xrt_space_relation_flags)(XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+		                                    XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+		if ((slam_relation.relation_flags & tracked_bits) == tracked_bits) {
+			*out_relation = slam_relation;
+			return XRT_SUCCESS;
+		}
+	}
+
 	struct xrt_space_relation new_relation = XRT_SPACE_RELATION_ZERO;
 
 	os_mutex_lock(&d->lock);
@@ -351,7 +368,7 @@ android_device_compute_distortion(
 
 
 struct android_device *
-android_device_create(void)
+android_device_create(struct xrt_prober *xp)
 {
 	enum u_device_alloc_flags flags =
 	    (enum u_device_alloc_flags)(U_DEVICE_ALLOC_HMD | U_DEVICE_ALLOC_TRACKING_NONE);
@@ -448,6 +465,18 @@ android_device_create(void)
 	d->base.supported.orientation_tracking = true;
 	d->base.supported.position_tracking = false;
 
+	// Attach the SLAM tracker when the prober factory can create one
+	// (same pattern as the EuRoC device). Without a VIT backend the
+	// factory fails and the device stays 3DoF, exactly as before.
+	if (xp != NULL && xp->tracking != NULL &&
+	    xp->tracking->create_tracked_slam(xp->tracking, &d->slam) >= 0 && d->slam != NULL) {
+		d->tracking_origin.type = XRT_TRACKING_TYPE_EXTERNAL_SLAM;
+		snprintf(d->tracking_origin.name, XRT_TRACKING_NAME_LEN, "%s", "Android SLAM Tracker");
+		d->base.tracking_origin = &d->tracking_origin;
+		d->base.supported.position_tracking = true;
+		ANDROID_INFO(d, "SLAM tracker attached: 6DoF poses enabled");
+	}
+
 	ANDROID_DEBUG(d, "Created device!");
 
 	return d;
