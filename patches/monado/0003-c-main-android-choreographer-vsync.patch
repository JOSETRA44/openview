+#ifdef COMP_HAVE_ANDROID_VSYNC
+/*
+ * Android has no vblank events through Vulkan, so without this the pacer
+ * free-runs on a timer and drifts through the refresh cycle: frames then reach
+ * SurfaceFlinger at a random phase and some miss their vsync. Choreographer
+ * reports the vsync timeline in CLOCK_MONOTONIC, which the pacer locks to.
+ *
+ * The callback variant taking a long is the only one available at our minimum
+ * API level, and long only holds nanoseconds on 64-bit ABIs.
+ */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+static void
+android_vsync_callback(long frame_time_ns, void *data)
+{
+	struct comp_target_swapchain *cts = (struct comp_target_swapchain *)data;
+
+	os_thread_helper_lock(&cts->vblank.event_thread);
+	cts->vblank.last_vblank_ns = (uint64_t)((int64_t)frame_time_ns + cts->vblank.android_offset_ns);
+	os_thread_helper_unlock(&cts->vblank.event_thread);
+
+	// Callbacks are one-shot.
+	AChoreographer_postFrameCallback(AChoreographer_getInstance(), android_vsync_callback, data);
+}
+
+static void *
+run_android_vsync_thread(void *ptr)
+{
+	struct comp_target_swapchain *cts = (struct comp_target_swapchain *)ptr;
+
+	os_thread_name_self("Vsync Events");
+	U_TRACE_SET_THREAD_NAME("Vsync Events");
+
+	// Choreographer delivers callbacks on the looper of the thread that posted them.
+	ALooper_prepare(0);
+	AChoreographer_postFrameCallback(AChoreographer_getInstance(), android_vsync_callback, cts);
+
+	while (os_thread_helper_is_running(&cts->vblank.event_thread)) {
+		// The timeout bounds how long stopping the thread takes.
+		ALooper_pollOnce(100, NULL, NULL, NULL);
+	}
+
+	return NULL;
+}
+#pragma GCC diagnostic pop
+
+static bool
+create_android_vsync_thread(struct comp_target *ct)
+{
+	struct comp_target_swapchain *cts = (struct comp_target_swapchain *)ct;
+
+	cts->vblank.android_offset_ns = time_ms_f_to_ns(debug_get_float_option_android_vsync_offset_ms());
+
+	int thread_ret = os_thread_helper_start(&cts->vblank.event_thread, run_android_vsync_thread, cts);
+	if (thread_ret != 0) {
+		COMP_ERROR(ct->c, "Failed to start vsync event thread");
+		return false;
+	}
+
+	cts->vblank.thread_running = true;
+
+	return true;
+}
+#endif
+
 static void
 target_fini_semaphores(struct comp_target_swapchain *cts)
 {
